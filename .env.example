# ===========================================================================
# 1. TRỢ LÝ AI (tùy chọn — nhưng nên cấu hình để MỌI KHÁCH dùng được)
# ===========================================================================
# KHOÁ DÙNG CHUNG: khoá này nằm ở MÁY CHỦ, không bao giờ gửi xuống trình duyệt.
# Khi đã cấu hình, khách truy cập dùng trợ lý AI đầy đủ mà KHÔNG cần dán khoá riêng.
# Lấy miễn phí tại https://aistudio.google.com → Get API key.
# Khi để trống, hệ thống vẫn chạy Engine Chuyên gia Làng nghề tích hợp sẵn (không cần mạng).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cổng khởi chạy (mặc định Next.js là 3000)
PORT=3000

# ===========================================================================
# 2. SÀN THƯƠNG MẠI — CẤU HÌNH BẮT BUỘC CHO ĐƠN HÀNG
# ===========================================================================

# --- Email quản trị nhận thông báo đơn hàng ---------------------------------
# ĐÂY CHỈ LÀ ĐỊA CHỈ NHẬN THÔNG BÁO. Quyền quản trị chỉ được cấp khi tài khoản
# Google đã được xác minh ở server trùng với email này.
ADMIN_EMAIL=anhdhkafhl32466@gmail.com

# --- Khoá ký cookie phiên đăng nhập (bắt buộc cho production) ---------------
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Không được để trống và không được commit giá trị thật lên Git.
SESSION_SECRET=

# --- Khoá khởi tạo quyền quản trị (ADMIN_ACCESS_KEY) ------------------------
# Đường đăng nhập quản trị dự phòng, dùng khi CHƯA cấu hình được NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Tối thiểu 24 ký tự. Máy chủ so sánh bằng timingSafeEqual và chỉ cấp quyền admin cho ĐÚNG
# email ở ADMIN_EMAIL. Giống mật khẩu quản trị: KHÔNG commit, KHÔNG chia sẻ công khai.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Đổi khoá (rotate) bằng cách sửa giá trị này rồi khởi động lại máy chủ.
ADMIN_ACCESS_KEY=

# --- Cơ sở dữ liệu ----------------------------------------------------------
# Có DATABASE_URL  -> dùng PostgreSQL (khuyến nghị: Neon — https://neon.tech).
# Không có         -> dùng SQLite nhúng sẵn của Node, lưu tại thư mục .data
#                     (phù hợp phát triển/self-hosted; KHÔNG bền vững trên Vercel).
# Nhân bản connection string từ Neon: https://console.neon.tech → Connection Details
DATABASE_URL=

# Chỉ dùng khi muốn chỉ định vị trí file SQLite (tùy chọn).
# SQLITE_DB_FILE=

# Tồn kho khởi tạo cho mỗi sản phẩm khi nạp danh mục lần đầu (mặc định 20).
# CATALOG_DEFAULT_STOCK=20

# --- Người bán (sàn đa người bán) -------------------------------------------
# Mặc định: hồ sơ đăng ký người bán vào trạng thái "chờ xét duyệt" và chỉ bán được
# sau khi quản trị viên duyệt ở /admin/cua-hang.
# Bật SELLER_AUTO_APPROVE=true để cho phép bán NGAY sau khi đăng ký (quản trị viên
# vẫn nhận thông báo để biết ai vừa tham gia sàn).
# SELLER_AUTO_APPROVE=false

# --- Lưu ảnh sản phẩm / logo cửa hàng ---------------------------------------
# Mặc định: lưu trên đĩa của máy chủ, tại .data/uploads. Trên Vercel đĩa là tạm (/tmp)
# nên hãy trỏ STORAGE_DIR sang đĩa bền hoặc dùng dịch vụ lưu trữ ngoài.
# STORAGE_DIR=
# Đặt khi ảnh được phục vụ từ miền/tên miền khác (S3, R2, CDN...). Khi có giá trị này,
# giao diện ghi rõ ảnh đã được phục vụ từ miền ngoài thay vì đĩa máy chủ.
# PUBLIC_MEDIA_BASE_URL=

# --- Dịch vụ gửi email giao dịch (Resend) -----------------------------------
# Lấy API key tại https://resend.com/api-keys
# Khi thiếu RESEND_API_KEY, hệ thống GHI RÕ là email chưa được gửi (không báo thành công giả)
# và vẫn lưu đơn hàng + thông báo trong website bình thường.
RESEND_API_KEY=
# Địa chỉ người gửi đã được xác minh trong Resend, ví dụ: "Lang Thang <donhang@tenmien.vn>"
EMAIL_FROM=

# --- Web Push (thông báo trên máy tính & điện thoại) ------------------------
# Sinh cặp khoá bằng:  npx web-push generate-vapid-keys
# LƯU Ý: Web Push chỉ hoạt động trên HTTPS (hoặc localhost) và khi người dùng đã đồng ý.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Liên hệ của người vận hành, dạng mailto: hoặc https:
VAPID_SUBJECT=mailto:anhdhkafhl32466@gmail.com

# --- Bản đồ / GPS / ĐỊNH TUYẾN ----------------------------------------------
# Mặc định hệ thống dùng hạ tầng OpenStreetMap công khai, KHÔNG cần API key:
#  - Định tuyến xe máy/ô tô: OSRM (FOSSGIS)
#  - Định tuyến đi bộ    : OSRM profile foot
#  - Geocoding           : Nominatim
#  - Điểm dừng & tuyến buýt: Overpass API
#
# Toạ độ kho xuất hàng mặc định là kết quả tra cứu THẬT cho Đại học FPT Hà Nội
# (xem lib/config/commerce.ts). Chỉ khai báo khi muốn đổi kho:
# WAREHOUSE_ADDRESS="Địa chỉ kho mới"
# WAREHOUSE_LAT=21.0135277
# WAREHOUSE_LNG=105.5252615
#
# Chỉ khai báo các biến dưới đây khi chuyển sang server tự vận hành (self-hosted):
# GEO_USER_AGENT="TenUngDung/1.0 (email-lien-he@example.com)"
# OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# OSRM_FALLBACK_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter

# ===========================================================================
# 3. ĐĂNG NHẬP GOOGLE (NEXT_PUBLIC_ — giá trị này công khai, không phải bí mật)
# ===========================================================================
# Dùng để xác minh ID token Google ở server (và để cấp quyền quản trị cho ADMIN_EMAIL).
# CHƯA cấu hình cũng không sao: quản trị viên vẫn vào được bằng ADMIN_ACCESS_KEY ở mục 2.
# Tạo tại https://console.cloud.google.com/apis/credentials (OAuth Client ID - Web).
# Thêm origin (ví dụ http://localhost:3000 và tên miền thật) vào Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
