[TEMPLATE]
# Tùy chọn: Khóa API cho tính năng Trợ lý AI và Khuyến nghị thông minh
# Nếu không cung cấp, hệ thống tự động sử dụng Local Knowledge Engine tích hợp sẵn
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cổng khởi chạy (Mặc định Next.js là 3000)
PORT=3000

# ---------------------------------------------------------------------------
# BẢN ĐỒ / GPS / ĐỊNH TUYẾN  (không bắt buộc — hệ thống đã có mặc định miễn phí)
# ---------------------------------------------------------------------------
# Mặc định hệ thống dùng hạ tầng OpenStreetMap công khai, KHÔNG cần API key:
#  - Định tuyến xe máy/ô tô: OSRM (FOSSGIS)
#  - Định tuyến đi bộ    : OSRM profile foot
#  - Geocoding           : Nominatim
#  - Điểm dừng & tuyến buýt: Overpass API
#
# Chỉ khai báo các biến dưới đây khi bạn muốn chuyển sang server tự vận hành
# (self-hosted) hoặc nhà cung cấp khác, nhằm tránh giới hạn của server công cộng.
#
# GEO_USER_AGENT="TenUngDung/1.0 (email-lien-he@example.com)"
# OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# OSRM_FALLBACK_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Danh sách máy chủ Overpass dự phòng (phân tách bằng dấu phẩy), dùng khi máy chủ chính quá tải.
# OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
